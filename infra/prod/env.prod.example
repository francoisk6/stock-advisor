# Production backend/.env for the closed web beta. Copy to
# ~/stock-advisor/stock-advisor-prod/backend/.env, fill the blanks, chmod 600. Never commit.
ENVIRONMENT=prod
DEBUG=false
INVITE_ONLY=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stock_advisor_prod
DB_USER=stock_advisor_prod
# 16+ chars: upper, lower, digit, one of - _ . + = ^ * ~
DB_PASSWORD=

# setup_prod.sh generates one
JWT_SECRET=

FRONTEND_URL=https://universal-stock-advisor.trade
CORS_ORIGINS=["https://universal-stock-advisor.trade"]
# the web client id, once the prod origin is added in Google Cloud
GOOGLE_CLIENT_IDS=[]

EMAIL_BACKEND=smtp
EMAIL_FROM=Universal Stock Advisor <your-sending-address@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=
# Gmail app password, pasted without spaces
SMTP_PASSWORD=
# where "site down" / "backup failed" alerts go
OPS_ALERT_EMAIL=
