# Copy to backend/.env and fill in. Never commit .env.
ENVIRONMENT=dev
DEBUG=true

# Dedicated DB + user (MySQL server is shared with the evolution project).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stock_advisor
# DB_PASSWORD: 12+ chars: upper, lower, digit, one of - _ . + = ^ * ~
DB_PASSWORD=change-me
DB_NAME=stock_advisor_dev

# JSON list of allowed browser origins (Flutter web dev server runs on 8210).
CORS_ORIGINS=["http://localhost:8210","http://127.0.0.1:8210"]
# Dev only: allow the web app when opened via a LAN IP (http://192.168.x.x:8210).
CORS_ORIGIN_REGEX='^http://192\.168\.\d{1,3}\.\d{1,3}:8210$'

# Auth — generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Google Sign-In: JSON list of OAuth client IDs (web client, android client).
GOOGLE_CLIENT_IDS=[]

# Base URL of the Flutter web app (used in email links).
FRONTEND_URL=http://localhost:8210

# Email: outbox (dev: writes .eml files to EMAIL_OUTBOX_DIR) | smtp
# SMTP_SSL=true  -> TLS from the start (port 465)   [= EMAIL_USE_SSL=True]
# SMTP_STARTTLS  -> upgrade a plain connection (587) [= EMAIL_USE_TLS]
# Gmail: use an App Password (16 letters, no spaces), not the account password.
EMAIL_BACKEND=outbox
EMAIL_FROM=Stock Adviser <no-reply@localhost>
EMAIL_OUTBOX_DIR=var/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
